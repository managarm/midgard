# The configuration of midgard's guest kernel, merged on top of tinyconfig.
# The kernel only needs to drive midgard's platform: x2APICs with TSC-deadline
# timers, kvmclock, an I/O APIC, a CMOS RTC, a 16550A UART and virtio-mmio devices
# (declared on the command line). Minimal ACPI tables describe the CPUs and let the
# guest power off. There is no PCI bus (pci=off) and there are no modules.

CONFIG_64BIT=y
CONFIG_LOCALVERSION="-midgard"
CONFIG_DEFAULT_HOSTNAME="midgard"
CONFIG_KERNEL_GZIP=y
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y

# Core kernel features that userspace expects.
CONFIG_MULTIUSER=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_COREDUMP=y
CONFIG_ELF_CORE=y
# CONFIG_BASE_SMALL is not set
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_AIO=y
CONFIG_IO_URING=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_MEMBARRIER=y
CONFIG_RSEQ=y
CONFIG_FHANDLE=y
CONFIG_POSIX_TIMERS=y
CONFIG_SYSFS_SYSCALL=y
CONFIG_KALLSYMS=y
CONFIG_SECCOMP=y
# Sandboxes (systemd services, Chromium).
CONFIG_SECCOMP_FILTER=y
# Landlock: pacman (7+) sandboxes its downloads with it (and fails without it).
CONFIG_SECURITY=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_CGROUPS=y
# cgroup v2 controllers and BPF device control for systemd.
CONFIG_MEMCG=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CPUSETS=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_LOG_BUF_SHIFT=17

# Timers and scheduling.
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_PREEMPT_VOLUNTARY=y

# The platform.
CONFIG_SMP=y
CONFIG_NR_CPUS=64
CONFIG_X86_X2APIC=y
# midgard has ACPI tables, not an MP table.
# CONFIG_X86_MPPARSE is not set
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
CONFIG_EARLY_PRINTK=y
# KVM's PTP clock needs hypercalls that midgard does not implement.
# CONFIG_PTP_1588_CLOCK_KVM is not set
# The virtio devices are on a PCI bus (with ECAM) and interrupt with MSI-X. midgard
# has no configuration mechanism #1, so ECAM (MMCONFIG) is the only way to the PCI
# configuration space.
CONFIG_PCI=y
CONFIG_PCI_MMCONFIG=y
CONFIG_PCI_MSI=y
CONFIG_ACPI=y
# CONFIG_MODULES is not set

# Devices.
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
# Only /dev/pts, not 256 BSD pty pairs in /dev.
# CONFIG_LEGACY_PTYS is not set
# CONFIG_VT is not set
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
# midgard has one UART (COM1).
CONFIG_SERIAL_8250_NR_UARTS=1
CONFIG_SERIAL_8250_RUNTIME_UARTS=1
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
CONFIG_VIRTIO_PCI=y
# midgard's devices are modern-only.
# CONFIG_VIRTIO_PCI_LEGACY is not set
CONFIG_VIRTIO_CONSOLE=y
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_VIRTIO_BLK=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_DRV_CMOS=y

# Networking (virtio-net) and the host <-> guest channel (virtio-vsock).
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_VIRTIO_NET=y
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
# midgard passes the interface's configuration in ip=.
CONFIG_IP_PNP=y

# File systems: ext4 for the root disk, virtio-fs for /mnt/managarm.
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_FUSE_FS=y
CONFIG_VIRTIO_FS=y
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_AUTOFS_FS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_INOTIFY_USER=y
CONFIG_FILE_LOCKING=y
